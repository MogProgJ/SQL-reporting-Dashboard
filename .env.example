# SQL Reporting Dashboard — environment configuration
#
# Copy this file to .env:
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)
#
# Adjust the connection string if your Postgres setup differs
# from the Docker Compose defaults.

# PostgreSQL connection string
# Default matches docker-compose.yml: user=postgres, password=postgres, port=5434, db=reporting
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/reporting
